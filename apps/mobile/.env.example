# Copy to apps/mobile/.env for local overrides. NEVER commit .env.
# Expo exposes only variables prefixed with EXPO_PUBLIC_ to the app bundle.

# Base URL of the API incl. the /api/v1 prefix. When unset, the app runs offline-first from the
# on-device cache + bundled fixtures (T-050) and never waits on a request that cannot succeed.
EXPO_PUBLIC_API_URL=
