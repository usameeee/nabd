# Copy to apps/api/.env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=3000

# Browser origin allowed to call the API (the admin dev server).
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string (or local: mongodb://127.0.0.1:27017/nabd)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/nabd

# Long random string in real environments. Access token lifetime below.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m

# WHO ICD-11 API — only needed for the T-022 import script (`npm run import:icd11 -w @nabd/api`).
# Register a free client at https://icd.who.int/icdapi
ICD11_CLIENT_ID=
ICD11_CLIENT_SECRET=
# ICD-11 release to read, as YYYY-MM (ar + fr + en are required; see
# https://icd.who.int/docs/icd-api/SupportedClassifications).
ICD11_RELEASE=2026-01
